generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  PHRASE
  OTHER
}

enum VocabularyState {
  NEW
  LEARNING
  FAMILIAR
  ACTIVE
  MASTERED
  MAINTENANCE
}

enum TranslationLanguage {
  ENGLISH
  PERSIAN
  BOTH
}

enum RelationType {
  WORD_FAMILY
  SYNONYM
  ANTONYM
  DERIVED
  RELATED
  COLLOCATION
  PHRASE
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ExerciseType {
  MEANING_RECALL
  REVERSE_RECALL
  CLOZE
  COLLOCATION
  ARTICLE
  CASE_PREPOSITION
  FREE_SENTENCE
  PARAPHRASE
  CONTEXTUAL_CHOICE
}

enum SessionKind {
  DAILY_CHALLENGE
  FOCUS
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SessionActivity {
  WARMUP
  DUE_REVIEW
  NEW_WORD
  CONTEXT
  PRODUCTION
  FINAL_CHALLENGE
}

enum ConversationKind {
  PRACTICE
  MISSION
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
}

enum BattleGame {
  RAPID_RECALL
  ARTICLE
  COLLOCATION
  ODD_ONE_OUT
  SYNONYM
  PREPOSITION
}

enum BattleMode {
  TIMED
  UNTIMED
}

enum WritingMode {
  GUIDED
  OPEN
}

enum WritingStatus {
  ACTIVE
  EVALUATED
}

enum ConversationRole {
  USER
  ASSISTANT
}

enum ConfusionState {
  TRACKED
  LEARNED
}

enum RecommendationAction {
  ADDED
  DISMISSED
}

enum MistakeType {
  ARTICLE
  CASE
  PREPOSITION
  REFLEXIVE
  COLLOCATION
  WORD_CHOICE
  WORD_FORM
  SPELLING
  OTHER
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  preferredTranslation TranslationLanguage @default(ENGLISH)
  targetLevel          String              @default("B2")
  timezone             String              @default("UTC")
  vocabulary           UserVocabulary[]
  attempts             Attempt[]
  mistakes             Mistake[]
  encounters           Encounter[]
  aiUsage              AiUsageEvent[]
  topicPacks           TopicPack[]
  stories              Story[]
  readingDocuments     ReadingDocument[]
  learningSessions     LearningSession[]
  recommendationFeedback RecommendationFeedback[]
  confusionPairs         ConfusionPair[]
  conversationSessions   ConversationSession[]
  conversationMessages   ConversationMessage[]
  battleSessions         BattleSession[]
  writingSessions        WritingSession[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Lexeme {
  id           String           @id @default(cuid())
  lemma        String
  normalized   String
  language     String           @default("de")
  partOfSpeech PartOfSpeech
  article      String?
  gender       String?
  plural       String?
  cefrLevel    String?
  notes        String?
  translations Translation[]
  examples     Example[]
  patterns     LexicalPattern[]
  userStates   UserVocabulary[]
  outgoing     LexemeRelation[] @relation("source")
  incoming     LexemeRelation[] @relation("target")
  mistakes     Mistake[]
  encounters   Encounter[]
  insights     LexemeInsight[]
  topicPackItems TopicPackItem[]
  storyTargets StoryTarget[]
  readingItems ReadingItem[]
  sessionItems LearningSessionItem[]
  recommendationFeedback RecommendationFeedback[]
  confusionLeft  ConfusionPair[] @relation("confusionLeft")
  confusionRight ConfusionPair[] @relation("confusionRight")
  conversationTargets ConversationTarget[]
  battleQuestions BattleQuestion[]
  writingTargets WritingTarget[]
  createdAt    DateTime         @default(now())
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddingVersion Int?
  embeddedAt     DateTime?
  updatedAt    DateTime         @updatedAt

  @@unique([language, normalized, partOfSpeech])
  @@index([lemma])
}

model Translation {
  id       String @id @default(cuid())
  lexemeId String
  language String
  text     String
  lexeme   Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([lexemeId, language])
}

model LexicalPattern {
  id          String  @id @default(cuid())
  lexemeId    String
  pattern     String
  explanation String?
  lexeme      Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([lexemeId])
}

model Example {
  id            String  @id @default(cuid())
  lexemeId      String
  german        String
  english       String?
  persian       String?
  level         String?
  register      String?
  generatedByAi Boolean @default(false)
  lexeme        Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([lexemeId])
}

model LexemeRelation {
  id       String       @id @default(cuid())
  sourceId String
  targetId String
  type     RelationType
  source   Lexeme       @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Lexeme       @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId, type])
}

model UserVocabulary {
  id              String          @id @default(cuid())
  userId          String
  lexemeId        String
  state           VocabularyState @default(NEW)
  recognition     Float           @default(0)
  meaningRecall   Float           @default(0)
  production      Float           @default(0)
  listening       Float           @default(0)
  contextualUsage Float           @default(0)
  difficulty      Float?
  stability       Float?
  retrievability  Float?
  nextReviewAt    DateTime?
  masteredAt      DateTime?
  fsrsCard        Json?
  addedAt         DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme          Lexeme          @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  reviews         Review[]
  attempts        Attempt[]

  @@unique([userId, lexemeId])
  @@index([userId, state])
  @@index([userId, nextReviewAt])
  @@index([userId, addedAt])
}

model Review {
  id               String       @id @default(cuid())
  userVocabularyId String
  rating           ReviewRating
  reviewedAt       DateTime     @default(now())
  previousCard     Json
  nextCard         Json
  userVocabulary   UserVocabulary @relation(fields: [userVocabularyId], references: [id], onDelete: Cascade)

  @@index([userVocabularyId, reviewedAt])
}

model Attempt {
  id               String          @id @default(cuid())
  userId           String
  userVocabularyId String?
  exerciseType     ExerciseType
  prompt           String
  answer           String
  expected         String?
  correct          Boolean
  score            Float?
  feedback         String?
  durationMs       Int?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userVocabulary   UserVocabulary? @relation(fields: [userVocabularyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Mistake {
  id             String      @id @default(cuid())
  userId         String
  lexemeId       String?
  type           MistakeType
  expected       String?
  actual         String?
  explanation    String?
  occurrences    Int         @default(1)
  lastOccurredAt DateTime     @default(now())
  resolvedAt     DateTime?
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddingVersion Int?
  embeddedAt     DateTime?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme         Lexeme?     @relation(fields: [lexemeId], references: [id], onDelete: SetNull)

  @@index([userId, type, lastOccurredAt])
  @@index([userId, lexemeId, type])
  @@index([userId, resolvedAt, lastOccurredAt])
}

model Encounter {
  id        String   @id @default(cuid())
  userId    String
  lexemeId  String
  source    String
  sourceRef String?
  context   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme    Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([userId, lexemeId, createdAt])
  @@unique([userId, lexemeId, source, sourceRef])
}


enum AIUsageStatus {
  SUCCESS
  ERROR
}

model AiUsageEvent {
  id                 String        @id @default(cuid())
  userId             String
  operation          String
  provider           String        @default("openai")
  model              String
  promptVersion      String?
  status             AIUsageStatus
  inputTokens        Int           @default(0)
  cachedInputTokens  Int           @default(0)
  outputTokens       Int           @default(0)
  reasoningTokens    Int           @default(0)
  totalTokens        Int           @default(0)
  inputCost          Decimal?      @db.Decimal(18, 10)
  cachedInputCost    Decimal?      @db.Decimal(18, 10)
  outputCost         Decimal?      @db.Decimal(18, 10)
  reasoningCost      Decimal?      @db.Decimal(18, 10)
  totalCost          Decimal?      @db.Decimal(18, 10)
  currency           String        @default("USD")
  pricingKey         String?
  durationMs         Int?
  timeToFirstTokenMs Int?
  retryCount         Int?
  requestId          String?
  errorMessage       String?
  errorCategory      String?
  metadata           Json?
  createdAt          DateTime      @default(now())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, operation, createdAt])
  @@index([userId, model, createdAt])
  @@index([userId, status, createdAt])
  @@map("AIUsageEvent")
}



model AiGenerationCache {
  id            String   @id @default(cuid())
  cacheKey      String   @unique
  operation     String
  promptVersion String
  schemaVersion String
  sourceHash    String
  payload       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([operation, updatedAt])
}

model LexemeInsight {
  id                 String   @id @default(cuid())
  lexemeId           String
  level              String
  germanDefinition   String
  englishExplanation String
  persianExplanation String
  grammarNotes       String
  comparisonTarget   String?
  comparisonNotes    String?
  version            Int      @default(1)
  generatedByAi      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lexeme             Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([lexemeId, level])
  @@index([lexemeId, updatedAt])
}


model TopicPack {
  id        String          @id @default(cuid())
  userId    String
  title     String
  topic     String
  level     String
  description String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     TopicPackItem[]

  @@index([userId, createdAt])
}

model TopicPackItem {
  id             String    @id @default(cuid())
  topicPackId    String
  lexemeId       String
  rationale      String?
  usefulness     Int       @default(3)
  position       Int       @default(0)
  topicPack      TopicPack @relation(fields: [topicPackId], references: [id], onDelete: Cascade)
  lexeme         Lexeme    @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([topicPackId, lexemeId])
  @@index([topicPackId, position])
  @@index([lexemeId])
}

model Story {
  id           String       @id @default(cuid())
  userId       String
  title        String
  topic        String?
  level        String
  length       String
  content      String
  englishSummary String?
  persianSummary String?
  questions    Json
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets      StoryTarget[]

  @@index([userId, createdAt])
}

model StoryTarget {
  id        String @id @default(cuid())
  storyId   String
  lexemeId  String
  position  Int    @default(0)
  story     Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  lexeme    Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([storyId, lexemeId])
  @@index([storyId, position])
}


model ReadingDocument {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  sourceType String       @default("PASTED_TEXT")
  sourceRef String?
  content   String
  level     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ReadingItem[]

  @@index([userId, createdAt])
}

model ReadingItem {
  id                String          @id @default(cuid())
  readingDocumentId String
  lexemeId          String
  surfaceText       String
  surfaceForms      Json
  occurrences       Int             @default(1)
  position          Int             @default(0)
  readingDocument   ReadingDocument @relation(fields: [readingDocumentId], references: [id], onDelete: Cascade)
  lexeme            Lexeme          @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([readingDocumentId, lexemeId])
  @@index([readingDocumentId, position])
}


model LearningSession {
  id              String                @id @default(cuid())
  userId          String
  kind            SessionKind
  status          SessionStatus         @default(ACTIVE)
  plannedMinutes  Int
  currentStep     Int                   @default(0)
  startedAt       DateTime              @default(now())
  lastActiveAt    DateTime              @default(now())
  completedAt     DateTime?
  summary         Json?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           LearningSessionItem[]

  @@index([userId, status, lastActiveAt])
}

model LearningSessionItem {
  id               String          @id @default(cuid())
  learningSessionId String
  activity         SessionActivity
  lexemeId         String?
  title            String
  description      String?
  href             String
  position         Int
  plannedMinutes   Int
  completedAt      DateTime?
  learningSession  LearningSession @relation(fields: [learningSessionId], references: [id], onDelete: Cascade)
  lexeme           Lexeme?         @relation(fields: [lexemeId], references: [id], onDelete: SetNull)

  @@unique([learningSessionId, position])
  @@index([learningSessionId, position])
}


model RecommendationFeedback {
  id        String               @id @default(cuid())
  userId    String
  lexemeId  String
  action    RecommendationAction
  rationale String?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme    Lexeme               @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([userId, lexemeId])
  @@index([userId, action, createdAt])
}


model ConfusionPair {
  id              String         @id @default(cuid())
  userId          String
  leftLexemeId    String
  rightLexemeId   String
  state           ConfusionState @default(TRACKED)
  content         Json?
  attempts        Int            @default(0)
  correctAttempts Int            @default(0)
  lastPracticedAt DateTime?
  learnedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leftLexeme      Lexeme         @relation("confusionLeft", fields: [leftLexemeId], references: [id], onDelete: Cascade)
  rightLexeme     Lexeme         @relation("confusionRight", fields: [rightLexemeId], references: [id], onDelete: Cascade)

  @@unique([userId, leftLexemeId, rightLexemeId])
  @@index([userId, state, updatedAt])
}


model ConversationSession {
  id            String             @id @default(cuid())
  userId        String
  kind          ConversationKind
  status        ConversationStatus @default(ACTIVE)
  level         String
  title         String
  scenario      String
  aiRole        String
  objective     String?
  revealTargets Boolean            @default(true)
  summary       Json?
  turnInFlight  Boolean            @default(false)
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]
  targets       ConversationTarget[]

  @@index([userId, status, updatedAt])
}

model ConversationMessage {
  id        String           @id @default(cuid())
  sessionId String
  userId    String
  role      ConversationRole
  content   String
  createdAt DateTime         @default(now())
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ConversationTarget {
  id             String              @id @default(cuid())
  sessionId      String
  lexemeId       String
  position       Int                 @default(0)
  uses           Int                 @default(0)
  successfulUses Int                 @default(0)
  lastUsedAt     DateTime?
  session        ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lexeme         Lexeme              @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, lexemeId])
  @@index([sessionId, position])
}


model BattleSession {
  id          String       @id @default(cuid())
  userId      String
  game        BattleGame
  mode        BattleMode
  durationSec Int?
  score       Int          @default(0)
  correct     Int          @default(0)
  total       Int          @default(0)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   BattleQuestion[]

  @@index([userId, startedAt])
}

model BattleQuestion {
  id          String        @id @default(cuid())
  sessionId   String
  lexemeId    String?
  position    Int
  prompt      String
  options     Json
  expected    String
  explanation String?
  answer      String?
  correct     Boolean?
  responseMs  Int?
  answeredAt  DateTime?
  session     BattleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lexeme      Lexeme?       @relation(fields: [lexemeId], references: [id], onDelete: SetNull)

  @@unique([sessionId, position])
  @@index([sessionId, position])
}

model WritingSession {
  id           String        @id @default(cuid())
  userId       String
  parentId     String?
  mode         WritingMode
  status       WritingStatus @default(ACTIVE)
  level        String
  taskType     String
  topic        String
  targetWords  Int
  task         String
  draft        String        @default("")
  wordCount    Int           @default(0)
  evaluation   Json?
  createdAt    DateTime      @default(now())
  evaluatedAt  DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets      WritingTarget[]

  @@index([userId, createdAt])
  @@index([parentId])
}

model WritingTarget {
  id               String         @id @default(cuid())
  writingSessionId String
  lexemeId         String
  position         Int            @default(0)
  writingSession   WritingSession @relation(fields: [writingSessionId], references: [id], onDelete: Cascade)
  lexeme           Lexeme         @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([writingSessionId, lexemeId])
  @@index([writingSessionId, position])
}
