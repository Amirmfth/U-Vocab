# Copy this file to .env so both Prisma and Next.js can read it.
# Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon direct/unpooled connection string for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# OpenAI. Override with any Responses API model you choose.
OPENAI_API_KEY="sk-..."
AI_PROVIDER="openai"
OPENAI_MODEL="gpt-6-luna"
OPENAI_MAX_RETRIES="2"
OPENAI_TIMEOUT_MS="90000"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_VERSION="1"

# Better Auth. Use a random high-entropy secret of at least 32 bytes.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Canonical public origin, no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated additional trusted origins for preview/staging deployments.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Transactional authentication email (Resend HTTP API).
# In development, verification/reset links are logged if these are unset.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="U-Vocab <auth@example.com>"

# One-time bootstrap for an existing pre-multi-user deployment.
# Set these only while running: npm run auth:bootstrap
AUTH_BOOTSTRAP_EMAIL=""
AUTH_BOOTSTRAP_PASSWORD=""
AUTH_BOOTSTRAP_NAME=""


# Observability: Sentry (optional; app works when unset)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Release/environment metadata shared by Sentry/PostHog context.
# Vercel commit/environment variables are used automatically when these are unset.
NEXT_PUBLIC_APP_ENV=""
NEXT_PUBLIC_APP_RELEASE=""
GIT_COMMIT_SHA=""

# Product analytics: PostHog (optional; disabled when unset).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Disable product analytics independently of operational Sentry telemetry.
NEXT_PUBLIC_ANALYTICS_DISABLED="false"
# Session replay is opt-in and remains separately disabled by default.
NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED="false"

# Explicitly enable the authenticated observability smoke endpoint only while testing.
OBSERVABILITY_SMOKE_ENABLED="false"

# Optional deep links shown only in the internal admin System page.
SENTRY_DASHBOARD_URL=""
POSTHOG_DASHBOARD_URL=""

# Emergency-only override for scripts/promote-admin.ts after an ADMIN already exists.
ALLOW_ADMIN_BOOTSTRAP_WITH_EXISTING="false"
