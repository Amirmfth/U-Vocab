# Copy this file to .env so both Prisma and Next.js can read it.
# Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon direct/unpooled connection string for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# OpenAI. Override with any Responses API model you choose.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_VERSION="1"

# U-Vocab is currently a personal/single-user app.
APP_USER_EMAIL="amir@u-vocab.local"
