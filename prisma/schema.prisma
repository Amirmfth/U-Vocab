generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  PHRASE
  OTHER
}

enum VocabularyState {
  NEW
  LEARNING
  FAMILIAR
  ACTIVE
  MASTERED
  MAINTENANCE
}

enum TranslationLanguage {
  ENGLISH
  PERSIAN
  BOTH
}

enum UiLocale {
  EN
  FA
}

enum TargetLanguage {
  GERMAN
  FRENCH
  ENGLISH
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum GrammarCategory {
  SENTENCE_STRUCTURE
  CASES
  VERBS
  TENSES
  ARTICLES
  ADJECTIVES
  PREPOSITIONS
  PRONOUNS
  CONJUNCTIONS
  RELATIVE_CLAUSES
  NEGATION
  COMPARISON
  PASSIVE
  SUBJUNCTIVE
  INFINITIVE_CONSTRUCTIONS
  NOUNS
  ADVERBS_PARTICLES
  WORD_FORMATION
}

enum GrammarRelationType {
  RELATED
  CONTRASTS_WITH
  EXTENDS
}

enum GrammarProgressStatus {
  UNASSESSED
  ASSUMED
  LEARNING
  STRONG
  NEEDS_ATTENTION
}

enum GrammarProgressSource {
  DECLARED_LEVEL
  EVIDENCE
  MANUAL
}

enum GrammarEvidenceSource {
  PRACTICE
  WRITING
  READING_COMPREHENSION
  CONVERSATION
  MANUAL
}

enum GrammarEvidenceOutcome {
  SUCCESS
  ERROR
  OPPORTUNITY
  ENCOUNTER
}

enum GrammarEvidenceDimension {
  UNDERSTANDING
  CONTROLLED_PRODUCTION
  FREE_PRODUCTION
}

enum RelationType {
  WORD_FAMILY
  SYNONYM
  ANTONYM
  DERIVED
  RELATED
  COLLOCATION
  PHRASE
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ExerciseType {
  MEANING_RECALL
  REVERSE_RECALL
  CLOZE
  COLLOCATION
  ARTICLE
  CASE_PREPOSITION
  FREE_SENTENCE
  PARAPHRASE
  CONTEXTUAL_CHOICE
  GRAMMAR_CHOICE
  GRAMMAR_CLOZE
  GRAMMAR_REORDER
  GRAMMAR_CORRECTION
}

enum SessionKind {
  DAILY_CHALLENGE
  FOCUS
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SessionActivity {
  WARMUP
  DUE_REVIEW
  NEW_WORD
  CONTEXT
  PRODUCTION
  FINAL_CHALLENGE
  GRAMMAR
}

enum ConversationKind {
  PRACTICE
  MISSION
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
}

enum ConversationTone {
  FRIENDLY
  PROFESSIONAL
  PLAYFUL
  DIRECT
  SUPPORTIVE
}

enum ConversationFormality {
  CASUAL
  NEUTRAL
  FORMAL
}

enum BattleGame {
  RAPID_RECALL
  ARTICLE
  COLLOCATION
  ODD_ONE_OUT
  SYNONYM
  PREPOSITION
}

enum BattleMode {
  TIMED
  UNTIMED
}

enum WritingMode {
  GUIDED
  OPEN
}

enum WritingStatus {
  ACTIVE
  EVALUATED
}

enum ConversationRole {
  USER
  ASSISTANT
}

enum ConfusionState {
  TRACKED
  LEARNED
}

enum RecommendationAction {
  ADDED
  DISMISSED
}

enum MistakeType {
  ARTICLE
  CASE
  PREPOSITION
  REFLEXIVE
  COLLOCATION
  ADJECTIVE_ENDING
  VERB_POSITION
  WORD_ORDER
  TENSE
  CONJUGATION
  PRONOUN
  AGREEMENT
  RELATIVE_CLAUSE
  PASSIVE
  SUBJUNCTIVE
  WORD_CHOICE
  WORD_FORM
  SPELLING
  OTHER
}

enum LexemeGrammarRelationType {
  EXEMPLIFIES
  GOVERNS
  TRIGGERS
  COMMON_WITH
}

enum LexemeGrammarLinkSource {
  DETERMINISTIC
  AI
  MANUAL
}

enum LexemeAliasKind {
  USER_INPUT
  ARTICLE_VARIANT
  SPELLING_VARIANT
  INFLECTED_FORM
  IMPORTED
  GENERATED
}

enum LexemeDataSource {
  CURATED
  IMPORTED
  AI_GENERATED
  USER_CONFIRMED
}

enum LexemeReviewState {
  UNREVIEWED
  ACCEPTED
  FLAGGED
  CURATED
}

model User {
  id                   String              @id @default(cuid())
  name                 String              @default("")
  email                String              @unique
  emailVerified        Boolean             @default(false)
  image                String?
  timezone             String              @default("UTC")
  uiLocale             UiLocale            @default(EN)
  onboardingCompletedAt DateTime?
  onboardingVersion    Int                 @default(0)
  onboardingStep       Int                 @default(1)
  activeCourseId       String?             @unique
  activeCourse         UserCourse?         @relation("ActiveCourse", fields: [activeCourseId], references: [id], onDelete: SetNull)
  courses              UserCourse[]        @relation("UserCourses")
  sessions             Session[]
  accounts             Account[]
  vocabulary           UserVocabulary[]
  attempts             Attempt[]
  mistakes             Mistake[]
  encounters           Encounter[]
  aiUsage              AiUsageEvent[]
  topicPacks           TopicPack[]
  stories              Story[]
  readingDocuments     ReadingDocument[]
  learningSessions     LearningSession[]
  recommendationFeedback RecommendationFeedback[]
  confusionPairs         ConfusionPair[]
  conversationSessions   ConversationSession[]
  conversationMessages   ConversationMessage[]
  battleSessions         BattleSession[]
  writingSessions        WritingSession[]
  grammarProgress        UserGrammarProgress[]
  grammarEvidence        GrammarEvidence[]
  grammarTransitions     GrammarProgressTransition[]
  grammarRecommendationEvents GrammarRecommendationEvent[]
  guideStates          UserGuideState[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model UserCourse {
  id                    String              @id @default(cuid())
  userId                String
  targetLanguage        TargetLanguage
  currentLevel          CefrLevel           @default(A1)
  targetLevel           CefrLevel           @default(B2)
  explanationLanguage   TranslationLanguage @default(ENGLISH)
  status                CourseStatus        @default(ACTIVE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation("UserCourses", fields: [userId], references: [id], onDelete: Cascade)
  activeFor             User?               @relation("ActiveCourse")
  vocabulary            UserVocabulary[]
  attempts              Attempt[]
  mistakes              Mistake[]
  encounters            Encounter[]
  aiUsage               AiUsageEvent[]
  topicPacks            TopicPack[]
  stories               Story[]
  readingDocuments      ReadingDocument[]
  learningSessions      LearningSession[]
  recommendationFeedback RecommendationFeedback[]
  confusionPairs        ConfusionPair[]
  conversationSessions  ConversationSession[]
  battleSessions        BattleSession[]
  writingSessions       WritingSession[]
  grammarProgress       UserGrammarProgress[]
  grammarEvidence       GrammarEvidence[]
  grammarTransitions    GrammarProgressTransition[]
  grammarRecommendationEvents GrammarRecommendationEvent[]

  @@unique([userId, targetLanguage])
  @@index([userId, status])
}

model UserGuideState {
  id          String   @id @default(cuid())
  userId      String
  guideId     String
  version     Int      @default(1)
  seenAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guideId])
  @@index([userId, dismissedAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model GrammarConcept {
  id               String                   @id
  slug             String                   @unique
  language         String                   @default("de")
  title            String
  shortDescription String
  category         GrammarCategory
  introducedAt     CefrLevel
  expectedBy       CefrLevel?
  reinforcedAt     CefrLevel[]
  order            Int
  contentVersion   Int                      @default(1)
  active           Boolean                  @default(true)
  explanation      String?
  rules            Json?
  exceptions       Json?
  examples         Json?
  parentId         String?
  parent           GrammarConcept?          @relation("GrammarConceptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         GrammarConcept[]         @relation("GrammarConceptTree")
  prerequisites    GrammarPrerequisite[]    @relation("GrammarPrerequisiteConcept")
  requiredBy       GrammarPrerequisite[]    @relation("GrammarPrerequisiteRequirement")
  outgoingRelations GrammarConceptRelation[] @relation("GrammarRelationSource")
  incomingRelations GrammarConceptRelation[] @relation("GrammarRelationTarget")
  userProgress     UserGrammarProgress[]
  evidence         GrammarEvidence[]
  lexemeLinks       LexemeGrammarConcept[]
  readingTargets    StoryGrammarTarget[]
  attempts          Attempt[]
  mistakes          Mistake[]
  progressTransitions GrammarProgressTransition[]
  recommendationEvents GrammarRecommendationEvent[]
  lessons           GrammarLesson[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([language, category, order])
  @@index([introducedAt, expectedBy])
  @@index([parentId, order])
}

model GrammarLesson {
  id                 String         @id @default(cuid())
  grammarConceptId   String
  language           String         @default("en")
  version            Int            @default(1)
  promptVersion      String         @default("v1")
  generatedByAi      Boolean        @default(true)
  overview           String
  intuition          String
  whenToUse          Json
  recognitionCues    Json
  formation          Json
  ruleDetails        Json
  tables             Json
  examples           Json
  contrasts          Json
  commonMistakes     Json
  exceptions         Json
  usageNotes         Json
  speakingWritingTips Json
  memoryAids         Json
  cheatSheet         Json
  sourceContentVersion Int
  generatedAt        DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  grammarConcept     GrammarConcept @relation(fields: [grammarConceptId], references: [id], onDelete: Cascade)

  @@unique([grammarConceptId, language])
  @@index([updatedAt])
}

model GrammarPrerequisite {
  id             String         @id @default(cuid())
  conceptId      String
  prerequisiteId String
  concept        GrammarConcept @relation("GrammarPrerequisiteConcept", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite   GrammarConcept @relation("GrammarPrerequisiteRequirement", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteId])
  @@index([prerequisiteId])
}

model GrammarConceptRelation {
  id       String              @id @default(cuid())
  sourceId String
  targetId String
  type     GrammarRelationType @default(RELATED)
  source   GrammarConcept      @relation("GrammarRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   GrammarConcept      @relation("GrammarRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId, type])
}

model UserGrammarProgress {
  id                   String                @id @default(cuid())
  userId               String
  userCourseId     String
  grammarConceptId     String
  status               GrammarProgressStatus @default(UNASSESSED)
  source               GrammarProgressSource @default(DECLARED_LEVEL)
  assumedFromLevel     CefrLevel?
  understanding        Float                 @default(0)
  controlledProduction Float                 @default(0)
  freeProduction       Float                 @default(0)
  evidenceCount        Int                   @default(0)
  lastEvidenceAt       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  grammarConcept       GrammarConcept        @relation(fields: [grammarConceptId], references: [id], onDelete: Cascade)

  @@unique([userCourseId, grammarConceptId])
  @@index([userCourseId, status])
  @@index([grammarConceptId, status])
  @@index([userCourseId, lastEvidenceAt])
  @@index([userCourseId])
}

model GrammarEvidence {
  id               String                   @id @default(cuid())
  userId           String
  userCourseId     String
  grammarConceptId String
  source           GrammarEvidenceSource
  outcome          GrammarEvidenceOutcome
  dimension        GrammarEvidenceDimension
  strength         Float
  confidence       Float                    @default(1)
  effectiveWeight  Float
  accepted         Boolean                  @default(true)
  dedupeKey        String
  sourceRef        String?
  excerpt          String?
  metadata         Json?
  createdAt        DateTime                 @default(now())
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  grammarConcept   GrammarConcept           @relation(fields: [grammarConceptId], references: [id], onDelete: Cascade)

  @@unique([userCourseId, dedupeKey])
  @@index([userCourseId, grammarConceptId, createdAt])
  @@index([grammarConceptId, outcome, createdAt])
  @@index([userCourseId])
}

model GrammarProgressTransition {
  id               String                @id @default(cuid())
  userId           String
  userCourseId     String
  grammarConceptId String
  fromStatus       GrammarProgressStatus?
  toStatus         GrammarProgressStatus
  source           GrammarProgressSource
  createdAt        DateTime              @default(now())
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  grammarConcept   GrammarConcept        @relation(fields: [grammarConceptId], references: [id], onDelete: Cascade)

  @@index([userCourseId, createdAt])
  @@index([userCourseId, grammarConceptId, createdAt])
  @@index([grammarConceptId, toStatus, createdAt])
  @@index([userCourseId])
}

model GrammarRecommendationEvent {
  id               String         @id @default(cuid())
  userId           String
  userCourseId     String
  grammarConceptId String
  surface          String
  reason           String
  action           String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  grammarConcept   GrammarConcept @relation(fields: [grammarConceptId], references: [id], onDelete: Cascade)

  @@index([userCourseId, createdAt])
  @@index([userCourseId, surface, reason, createdAt])
  @@index([grammarConceptId, action, createdAt])
  @@index([userCourseId])
}

model Lexeme {
  id           String           @id @default(cuid())
  lemma        String
  normalized   String
  language     String           @default("de")
  partOfSpeech PartOfSpeech
  article      String?
  gender       String?
  plural       String?
  cefrLevel    String?
  notes        String?
  translations Translation[]
  senses       LexemeSense[]
  aliases      LexemeAlias[]
  provenance   LexemeProvenance[]
  examples     Example[]
  patterns     LexicalPattern[]
  userStates   UserVocabulary[]
  outgoing     LexemeRelation[] @relation("source")
  incoming     LexemeRelation[] @relation("target")
  mistakes     Mistake[]
  encounters   Encounter[]
  insights     LexemeInsight[]
  topicPackItems TopicPackItem[]
  storyTargets StoryTarget[]
  readingItems ReadingItem[]
  sessionItems LearningSessionItem[]
  recommendationFeedback RecommendationFeedback[]
  confusionLeft  ConfusionPair[] @relation("confusionLeft")
  confusionRight ConfusionPair[] @relation("confusionRight")
  conversationTargets ConversationTarget[]
  battleQuestions BattleQuestion[]
  writingTargets WritingTarget[]
  grammarLinks  LexemeGrammarConcept[]
  createdAt    DateTime         @default(now())
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddingVersion Int?
  embeddedAt     DateTime?
  canonicalUpdatedAt DateTime   @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([language, normalized, partOfSpeech])
  @@index([lemma])
}

model LexemeSense {
  id          String              @id @default(cuid())
  lexemeId    String
  key         String              @default("default")
  gloss       String?
  source      LexemeDataSource    @default(IMPORTED)
  reviewState LexemeReviewState   @default(UNREVIEWED)
  confidence  Float?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lexeme      Lexeme              @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  translations Translation[]
  provenance  LexemeProvenance[]

  @@unique([lexemeId, key])
  @@index([lexemeId, reviewState])
}

model LexemeAlias {
  id                String           @id @default(cuid())
  lexemeId          String
  language          String
  surface           String
  normalizedSurface String
  kind              LexemeAliasKind
  source            LexemeDataSource @default(IMPORTED)
  createdAt         DateTime         @default(now())
  lexeme            Lexeme           @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([language, normalizedSurface, lexemeId])
  @@index([language, normalizedSurface])
  @@index([lexemeId, kind])
}

model LexemeProvenance {
  id             String            @id @default(cuid())
  lexemeId       String
  senseId        String?
  source         LexemeDataSource
  provider       String?
  model          String?
  promptVersion  String?
  contentVersion String?
  confidence     Float?
  reviewState    LexemeReviewState @default(UNREVIEWED)
  createdAt      DateTime          @default(now())
  lexeme         Lexeme            @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  sense          LexemeSense?      @relation(fields: [senseId], references: [id], onDelete: SetNull)

  @@index([lexemeId, createdAt])
  @@index([senseId])
  @@index([source, reviewState])
}

model Translation {
  id       String @id @default(cuid())
  lexemeId String
  senseId  String?
  language String
  text     String
  lexeme   Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  sense    LexemeSense? @relation(fields: [senseId], references: [id], onDelete: SetNull)

  @@index([lexemeId, language])
  @@index([senseId, language])
}

model LexicalPattern {
  id          String  @id @default(cuid())
  lexemeId    String
  pattern     String
  explanation String?
  lexeme      Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  grammarLinks LexemeGrammarConcept[]

  @@index([lexemeId])
}

model Example {
  id            String  @id @default(cuid())
  lexemeId      String
  german        String
  english       String?
  persian       String?
  level         String?
  register      String?
  generatedByAi Boolean @default(false)
  lexeme        Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([lexemeId])
}

model LexemeRelation {
  id       String       @id @default(cuid())
  sourceId String
  targetId String
  type     RelationType
  source   Lexeme       @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Lexeme       @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId, type])
}

model LexemeGrammarConcept {
  id               String                    @id @default(cuid())
  lexemeId         String
  grammarConceptId String
  lexicalPatternId String?
  relationType     LexemeGrammarRelationType @default(EXEMPLIFIES)
  note             String?
  source           LexemeGrammarLinkSource   @default(DETERMINISTIC)
  confidence       Float                     @default(1)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  lexeme           Lexeme                    @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  grammarConcept   GrammarConcept            @relation(fields: [grammarConceptId], references: [id], onDelete: Cascade)
  lexicalPattern   LexicalPattern?           @relation(fields: [lexicalPatternId], references: [id], onDelete: SetNull)

  @@unique([lexemeId, grammarConceptId, relationType])
  @@index([grammarConceptId, lexemeId])
  @@index([lexicalPatternId])
}

model UserVocabulary {
  id              String          @id @default(cuid())
  userId          String
  userCourseId     String
  lexemeId        String
  state           VocabularyState @default(NEW)
  recognition     Float           @default(0)
  meaningRecall   Float           @default(0)
  production      Float           @default(0)
  listening       Float           @default(0)
  contextualUsage Float           @default(0)
  difficulty      Float?
  stability       Float?
  retrievability  Float?
  nextReviewAt    DateTime?
  masteredAt      DateTime?
  fsrsCard        Json?
  addedAt         DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  lexeme          Lexeme          @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  reviews         Review[]
  attempts        Attempt[]

  @@unique([userCourseId, lexemeId])
  @@index([userCourseId, state])
  @@index([userCourseId, nextReviewAt])
  @@index([userCourseId, addedAt])
  @@index([userCourseId])
}

model Review {
  id               String       @id @default(cuid())
  userVocabularyId String
  rating           ReviewRating
  reviewedAt       DateTime     @default(now())
  previousCard     Json
  nextCard         Json
  userVocabulary   UserVocabulary @relation(fields: [userVocabularyId], references: [id], onDelete: Cascade)

  @@index([userVocabularyId, reviewedAt])
}

model Attempt {
  id               String          @id @default(cuid())
  userId           String
  userCourseId     String
  userVocabularyId String?
  grammarConceptId String?
  exerciseType     ExerciseType
  prompt           String
  answer           String
  expected         String?
  correct          Boolean
  score            Float?
  feedback         String?
  durationMs       Int?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  userVocabulary   UserVocabulary? @relation(fields: [userVocabularyId], references: [id], onDelete: SetNull)
  grammarConcept   GrammarConcept?  @relation(fields: [grammarConceptId], references: [id], onDelete: SetNull)

  @@index([userCourseId, createdAt])
  @@index([userCourseId, grammarConceptId, createdAt])
  @@index([userCourseId])
}

model Mistake {
  id             String      @id @default(cuid())
  userId         String
  userCourseId     String
  lexemeId       String?
  grammarConceptId String?
  type           MistakeType
  expected       String?
  actual         String?
  explanation    String?
  occurrences    Int         @default(1)
  lastOccurredAt DateTime     @default(now())
  resolvedAt     DateTime?
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddingVersion Int?
  embeddedAt     DateTime?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  lexeme         Lexeme?     @relation(fields: [lexemeId], references: [id], onDelete: SetNull)
  grammarConcept GrammarConcept? @relation(fields: [grammarConceptId], references: [id], onDelete: SetNull)

  @@index([userCourseId, type, lastOccurredAt])
  @@index([userCourseId, grammarConceptId, resolvedAt, lastOccurredAt])
  @@index([userCourseId, lexemeId, type])
  @@index([userCourseId, resolvedAt, lastOccurredAt])
  @@index([userCourseId])
}

model Encounter {
  id        String   @id @default(cuid())
  userId    String
  userCourseId     String
  lexemeId  String
  source    String
  sourceRef String?
  context   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  lexeme    Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([userCourseId, lexemeId, createdAt])
  @@unique([userCourseId, lexemeId, source, sourceRef])
  @@index([userCourseId])
}


enum AIUsageStatus {
  SUCCESS
  ERROR
}

model AiUsageEvent {
  id                 String        @id @default(cuid())
  userId             String
  userCourseId       String?
  operation          String
  provider           String        @default("openai")
  model              String
  promptVersion      String?
  status             AIUsageStatus
  inputTokens        Int           @default(0)
  cachedInputTokens  Int           @default(0)
  outputTokens       Int           @default(0)
  reasoningTokens    Int           @default(0)
  totalTokens        Int           @default(0)
  inputCost          Decimal?      @db.Decimal(18, 10)
  cachedInputCost    Decimal?      @db.Decimal(18, 10)
  outputCost         Decimal?      @db.Decimal(18, 10)
  reasoningCost      Decimal?      @db.Decimal(18, 10)
  totalCost          Decimal?      @db.Decimal(18, 10)
  currency           String        @default("USD")
  pricingKey         String?
  durationMs         Int?
  timeToFirstTokenMs Int?
  retryCount         Int?
  requestId          String?
  errorMessage       String?
  errorCategory      String?
  metadata           Json?
  createdAt          DateTime      @default(now())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             UserCourse?    @relation(fields: [userCourseId], references: [id], onDelete: SetNull)

  @@index([userCourseId, createdAt])
  @@index([userId, operation, createdAt])
  @@index([userId, model, createdAt])
  @@index([userId, status, createdAt])
  @@map("AIUsageEvent")
  @@index([userId, createdAt])
}



model AiGenerationCache {
  id            String   @id @default(cuid())
  cacheKey      String   @unique
  operation     String
  promptVersion String
  schemaVersion String
  sourceHash    String
  payload       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([operation, updatedAt])
}

model LexemeInsight {
  id                 String   @id @default(cuid())
  lexemeId           String
  level              String
  germanDefinition   String
  englishExplanation String
  persianExplanation String
  grammarNotes       String
  comparisonTarget   String?
  comparisonNotes    String?
  version            Int      @default(1)
  generatedByAi      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lexeme             Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([lexemeId, level])
  @@index([lexemeId, updatedAt])
}


model TopicPack {
  id        String          @id @default(cuid())
  userId    String
  userCourseId     String
  title     String
  topic     String
  level     String
  description String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  items     TopicPackItem[]

  @@index([userId, createdAt])
  @@index([userCourseId])
}

model TopicPackItem {
  id             String    @id @default(cuid())
  topicPackId    String
  lexemeId       String
  rationale      String?
  usefulness     Int       @default(3)
  position       Int       @default(0)
  topicPack      TopicPack @relation(fields: [topicPackId], references: [id], onDelete: Cascade)
  lexeme         Lexeme    @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([topicPackId, lexemeId])
  @@index([topicPackId, position])
  @@index([lexemeId])
}

model Story {
  id           String       @id @default(cuid())
  userId       String
  userCourseId     String
  title        String
  topic        String?
  level        String
  length       String
  content      String
  englishSummary String?
  persianSummary String?
  questions    Json
  generationMeta Json?
  answers      Json?
  comprehensionScore Float?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  targets      StoryTarget[]
  grammarTargets StoryGrammarTarget[]

  @@index([userId, createdAt])
  @@index([userCourseId])
}

model StoryGrammarTarget {
  id               String         @id @default(cuid())
  storyId          String
  grammarConceptId String
  excerpt          String?
  explanation      String?
  intentional      Boolean        @default(true)
  position         Int            @default(0)
  story            Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  grammarConcept   GrammarConcept @relation(fields: [grammarConceptId], references: [id], onDelete: Cascade)

  @@unique([storyId, grammarConceptId, excerpt])
  @@index([storyId, position])
  @@index([grammarConceptId, storyId])
}

model StoryTarget {
  id        String @id @default(cuid())
  storyId   String
  lexemeId  String
  position  Int    @default(0)
  story     Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  lexeme    Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([storyId, lexemeId])
  @@index([storyId, position])
}


model ReadingDocument {
  id        String        @id @default(cuid())
  userId    String
  userCourseId     String
  title     String?
  sourceType String       @default("PASTED_TEXT")
  sourceRef String?
  content   String
  level     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  items     ReadingItem[]

  @@index([userId, createdAt])
  @@index([userCourseId])
}

model ReadingItem {
  id                String          @id @default(cuid())
  readingDocumentId String
  lexemeId          String
  surfaceText       String
  surfaceForms      Json
  occurrences       Int             @default(1)
  position          Int             @default(0)
  readingDocument   ReadingDocument @relation(fields: [readingDocumentId], references: [id], onDelete: Cascade)
  lexeme            Lexeme          @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([readingDocumentId, lexemeId])
  @@index([readingDocumentId, position])
}


model LearningSession {
  id              String                @id @default(cuid())
  userId          String
  userCourseId     String
  kind            SessionKind
  status          SessionStatus         @default(ACTIVE)
  plannedMinutes  Int
  currentStep     Int                   @default(0)
  startedAt       DateTime              @default(now())
  lastActiveAt    DateTime              @default(now())
  completedAt     DateTime?
  summary         Json?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  items           LearningSessionItem[]

  @@index([userId, status, lastActiveAt])
  @@index([userCourseId])
}

model LearningSessionItem {
  id               String          @id @default(cuid())
  learningSessionId String
  activity         SessionActivity
  lexemeId         String?
  title            String
  description      String?
  href             String
  position         Int
  plannedMinutes   Int
  completedAt      DateTime?
  learningSession  LearningSession @relation(fields: [learningSessionId], references: [id], onDelete: Cascade)
  lexeme           Lexeme?         @relation(fields: [lexemeId], references: [id], onDelete: SetNull)

  @@unique([learningSessionId, position])
  @@index([learningSessionId, position])
}


model RecommendationFeedback {
  id        String               @id @default(cuid())
  userId    String
  userCourseId     String
  lexemeId  String
  action    RecommendationAction
  rationale String?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  lexeme    Lexeme               @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([userCourseId, lexemeId])
  @@index([userCourseId, action, createdAt])
  @@index([userCourseId])
}


model ConfusionPair {
  id              String         @id @default(cuid())
  userId          String
  userCourseId     String
  leftLexemeId    String
  rightLexemeId   String
  state           ConfusionState @default(TRACKED)
  content         Json?
  attempts        Int            @default(0)
  correctAttempts Int            @default(0)
  lastPracticedAt DateTime?
  learnedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  leftLexeme      Lexeme         @relation("confusionLeft", fields: [leftLexemeId], references: [id], onDelete: Cascade)
  rightLexeme     Lexeme         @relation("confusionRight", fields: [rightLexemeId], references: [id], onDelete: Cascade)

  @@unique([userCourseId, leftLexemeId, rightLexemeId])
  @@index([userCourseId, state, updatedAt])
  @@index([userCourseId])
}


model ConversationSession {
  id            String             @id @default(cuid())
  userId        String
  userCourseId     String
  kind          ConversationKind
  status        ConversationStatus @default(ACTIVE)
  level         String
  title         String
  scenario      String
  aiRole        String
  objective     String?
  revealTargets Boolean            @default(true)
  tone          ConversationTone    @default(FRIENDLY)
  formality     ConversationFormality @default(NEUTRAL)
  summary       Json?
  turnInFlight  Boolean            @default(false)
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]
  targets       ConversationTarget[]

  @@index([userId, status, updatedAt])
  @@index([userCourseId])
}

model ConversationMessage {
  id        String           @id @default(cuid())
  sessionId String
  userId    String
  role      ConversationRole
  content   String
  createdAt DateTime         @default(now())
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ConversationTarget {
  id             String              @id @default(cuid())
  sessionId      String
  lexemeId       String
  position       Int                 @default(0)
  uses           Int                 @default(0)
  successfulUses Int                 @default(0)
  lastUsedAt     DateTime?
  session        ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lexeme         Lexeme              @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, lexemeId])
  @@index([sessionId, position])
}


model BattleSession {
  id          String       @id @default(cuid())
  userId      String
  userCourseId     String
  game        BattleGame
  mode        BattleMode
  durationSec Int?
  score       Int          @default(0)
  correct     Int          @default(0)
  total       Int          @default(0)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  questions   BattleQuestion[]

  @@index([userId, startedAt])
  @@index([userCourseId])
}

model BattleQuestion {
  id          String        @id @default(cuid())
  sessionId   String
  lexemeId    String?
  position    Int
  prompt      String
  options     Json
  expected    String
  explanation String?
  answer      String?
  correct     Boolean?
  responseMs  Int?
  answeredAt  DateTime?
  session     BattleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lexeme      Lexeme?       @relation(fields: [lexemeId], references: [id], onDelete: SetNull)

  @@unique([sessionId, position])
  @@index([sessionId, position])
}

model WritingSession {
  id           String        @id @default(cuid())
  userId       String
  userCourseId     String
  parentId     String?
  mode         WritingMode
  status       WritingStatus @default(ACTIVE)
  level        String
  taskType     String
  topic        String
  targetWords  Int
  task         String
  draft        String        @default("")
  wordCount    Int           @default(0)
  evaluation   Json?
  createdAt    DateTime      @default(now())
  evaluatedAt  DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               UserCourse             @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  targets      WritingTarget[]

  @@index([userId, createdAt])
  @@index([parentId])
  @@index([userCourseId])
}

model WritingTarget {
  id               String         @id @default(cuid())
  writingSessionId String
  lexemeId         String
  position         Int            @default(0)
  writingSession   WritingSession @relation(fields: [writingSessionId], references: [id], onDelete: Cascade)
  lexeme           Lexeme         @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([writingSessionId, lexemeId])
  @@index([writingSessionId, position])
}
