generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  PHRASE
  OTHER
}

enum VocabularyState {
  NEW
  LEARNING
  FAMILIAR
  ACTIVE
  MASTERED
  MAINTENANCE
}

enum TranslationLanguage {
  ENGLISH
  PERSIAN
  BOTH
}

enum RelationType {
  WORD_FAMILY
  SYNONYM
  ANTONYM
  DERIVED
  RELATED
  COLLOCATION
  PHRASE
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ExerciseType {
  MEANING_RECALL
  REVERSE_RECALL
  CLOZE
  COLLOCATION
  ARTICLE
  CASE_PREPOSITION
  FREE_SENTENCE
  PARAPHRASE
  CONTEXTUAL_CHOICE
}

enum SessionKind {
  DAILY_CHALLENGE
  FOCUS
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SessionActivity {
  WARMUP
  DUE_REVIEW
  NEW_WORD
  CONTEXT
  PRODUCTION
  FINAL_CHALLENGE
}

enum ConfusionState {
  TRACKED
  LEARNED
}

enum RecommendationAction {
  ADDED
  DISMISSED
}

enum MistakeType {
  ARTICLE
  CASE
  PREPOSITION
  REFLEXIVE
  COLLOCATION
  WORD_CHOICE
  WORD_FORM
  SPELLING
  OTHER
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  preferredTranslation TranslationLanguage @default(ENGLISH)
  targetLevel          String              @default("B2")
  timezone             String              @default("UTC")
  vocabulary           UserVocabulary[]
  attempts             Attempt[]
  mistakes             Mistake[]
  encounters           Encounter[]
  aiUsage              AiUsageEvent[]
  topicPacks           TopicPack[]
  stories              Story[]
  readingDocuments     ReadingDocument[]
  learningSessions     LearningSession[]
  recommendationFeedback RecommendationFeedback[]
  confusionPairs         ConfusionPair[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Lexeme {
  id           String           @id @default(cuid())
  lemma        String
  normalized   String
  language     String           @default("de")
  partOfSpeech PartOfSpeech
  article      String?
  gender       String?
  plural       String?
  notes        String?
  translations Translation[]
  examples     Example[]
  patterns     LexicalPattern[]
  userStates   UserVocabulary[]
  outgoing     LexemeRelation[] @relation("source")
  incoming     LexemeRelation[] @relation("target")
  mistakes     Mistake[]
  encounters   Encounter[]
  insights     LexemeInsight[]
  topicPackItems TopicPackItem[]
  storyTargets StoryTarget[]
  readingItems ReadingItem[]
  sessionItems LearningSessionItem[]
  recommendationFeedback RecommendationFeedback[]
  confusionLeft  ConfusionPair[] @relation("confusionLeft")
  confusionRight ConfusionPair[] @relation("confusionRight")
  createdAt    DateTime         @default(now())
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddingVersion Int?
  embeddedAt     DateTime?
  updatedAt    DateTime         @updatedAt

  @@unique([language, normalized, partOfSpeech])
  @@index([lemma])
}

model Translation {
  id       String @id @default(cuid())
  lexemeId String
  language String
  text     String
  lexeme   Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([lexemeId, language])
}

model LexicalPattern {
  id          String  @id @default(cuid())
  lexemeId    String
  pattern     String
  explanation String?
  lexeme      Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
}

model Example {
  id            String  @id @default(cuid())
  lexemeId      String
  german        String
  english       String?
  persian       String?
  level         String?
  register      String?
  generatedByAi Boolean @default(false)
  lexeme        Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
}

model LexemeRelation {
  id       String       @id @default(cuid())
  sourceId String
  targetId String
  type     RelationType
  source   Lexeme       @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Lexeme       @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
}

model UserVocabulary {
  id              String          @id @default(cuid())
  userId          String
  lexemeId        String
  state           VocabularyState @default(NEW)
  recognition     Float           @default(0)
  meaningRecall   Float           @default(0)
  production      Float           @default(0)
  listening       Float           @default(0)
  contextualUsage Float           @default(0)
  difficulty      Float?
  stability       Float?
  retrievability  Float?
  nextReviewAt    DateTime?
  masteredAt      DateTime?
  fsrsCard        Json?
  addedAt         DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme          Lexeme          @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  reviews         Review[]
  attempts        Attempt[]

  @@unique([userId, lexemeId])
  @@index([userId, state])
  @@index([userId, nextReviewAt])
}

model Review {
  id               String       @id @default(cuid())
  userVocabularyId String
  rating           ReviewRating
  reviewedAt       DateTime     @default(now())
  previousCard     Json
  nextCard         Json
  userVocabulary   UserVocabulary @relation(fields: [userVocabularyId], references: [id], onDelete: Cascade)

  @@index([userVocabularyId, reviewedAt])
}

model Attempt {
  id               String          @id @default(cuid())
  userId           String
  userVocabularyId String?
  exerciseType     ExerciseType
  prompt           String
  answer           String
  expected         String?
  correct          Boolean
  score            Float?
  feedback         String?
  durationMs       Int?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userVocabulary   UserVocabulary? @relation(fields: [userVocabularyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Mistake {
  id             String      @id @default(cuid())
  userId         String
  lexemeId       String?
  type           MistakeType
  expected       String?
  actual         String?
  explanation    String?
  occurrences    Int         @default(1)
  lastOccurredAt DateTime     @default(now())
  resolvedAt     DateTime?
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddingVersion Int?
  embeddedAt     DateTime?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme         Lexeme?     @relation(fields: [lexemeId], references: [id], onDelete: SetNull)

  @@index([userId, type, lastOccurredAt])
  @@index([userId, lexemeId, type])
}

model Encounter {
  id        String   @id @default(cuid())
  userId    String
  lexemeId  String
  source    String
  sourceRef String?
  context   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme    Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@index([userId, lexemeId, createdAt])
  @@unique([userId, lexemeId, source, sourceRef])
}


enum AIUsageStatus {
  SUCCESS
  ERROR
}

model AiUsageEvent {
  id           String        @id @default(cuid())
  userId       String
  operation    String
  model        String
  status       AIUsageStatus
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)
  totalTokens  Int           @default(0)
  requestId    String?
  errorMessage String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, operation, createdAt])
  @@index([userId, model, createdAt])
  @@map("AIUsageEvent")
}


model LexemeInsight {
  id                 String   @id @default(cuid())
  lexemeId           String
  level              String
  germanDefinition   String
  englishExplanation String
  persianExplanation String
  grammarNotes       String
  comparisonTarget   String?
  comparisonNotes    String?
  version            Int      @default(1)
  generatedByAi      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lexeme             Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([lexemeId, level])
  @@index([lexemeId, updatedAt])
}


model TopicPack {
  id        String          @id @default(cuid())
  userId    String
  title     String
  topic     String
  level     String
  description String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     TopicPackItem[]

  @@index([userId, createdAt])
}

model TopicPackItem {
  id             String    @id @default(cuid())
  topicPackId    String
  lexemeId       String
  rationale      String?
  usefulness     Int       @default(3)
  position       Int       @default(0)
  topicPack      TopicPack @relation(fields: [topicPackId], references: [id], onDelete: Cascade)
  lexeme         Lexeme    @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([topicPackId, lexemeId])
  @@index([topicPackId, position])
}

model Story {
  id           String       @id @default(cuid())
  userId       String
  title        String
  topic        String?
  level        String
  length       String
  content      String
  englishSummary String?
  persianSummary String?
  questions    Json
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets      StoryTarget[]

  @@index([userId, createdAt])
}

model StoryTarget {
  id        String @id @default(cuid())
  storyId   String
  lexemeId  String
  position  Int    @default(0)
  story     Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  lexeme    Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([storyId, lexemeId])
  @@index([storyId, position])
}


model ReadingDocument {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  sourceType String       @default("PASTED_TEXT")
  sourceRef String?
  content   String
  level     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ReadingItem[]

  @@index([userId, createdAt])
}

model ReadingItem {
  id                String          @id @default(cuid())
  readingDocumentId String
  lexemeId          String
  surfaceText       String
  surfaceForms      Json
  occurrences       Int             @default(1)
  position          Int             @default(0)
  readingDocument   ReadingDocument @relation(fields: [readingDocumentId], references: [id], onDelete: Cascade)
  lexeme            Lexeme          @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([readingDocumentId, lexemeId])
  @@index([readingDocumentId, position])
}


model LearningSession {
  id              String                @id @default(cuid())
  userId          String
  kind            SessionKind
  status          SessionStatus         @default(ACTIVE)
  plannedMinutes  Int
  currentStep     Int                   @default(0)
  startedAt       DateTime              @default(now())
  lastActiveAt    DateTime              @default(now())
  completedAt     DateTime?
  summary         Json?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           LearningSessionItem[]

  @@index([userId, status, lastActiveAt])
}

model LearningSessionItem {
  id               String          @id @default(cuid())
  learningSessionId String
  activity         SessionActivity
  lexemeId         String?
  title            String
  description      String?
  href             String
  position         Int
  plannedMinutes   Int
  completedAt      DateTime?
  learningSession  LearningSession @relation(fields: [learningSessionId], references: [id], onDelete: Cascade)
  lexeme           Lexeme?         @relation(fields: [lexemeId], references: [id], onDelete: SetNull)

  @@unique([learningSessionId, position])
  @@index([learningSessionId, position])
}


model RecommendationFeedback {
  id        String               @id @default(cuid())
  userId    String
  lexemeId  String
  action    RecommendationAction
  rationale String?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme    Lexeme               @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([userId, lexemeId])
  @@index([userId, action, createdAt])
}


model ConfusionPair {
  id              String         @id @default(cuid())
  userId          String
  leftLexemeId    String
  rightLexemeId   String
  state           ConfusionState @default(TRACKED)
  content         Json?
  attempts        Int            @default(0)
  correctAttempts Int            @default(0)
  lastPracticedAt DateTime?
  learnedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leftLexeme      Lexeme         @relation("confusionLeft", fields: [leftLexemeId], references: [id], onDelete: Cascade)
  rightLexeme     Lexeme         @relation("confusionRight", fields: [rightLexemeId], references: [id], onDelete: Cascade)

  @@unique([userId, leftLexemeId, rightLexemeId])
  @@index([userId, state, updatedAt])
}
